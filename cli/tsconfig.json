{
  "compilerOptions": {
    // Layout dos Arquivos
    "rootDir": "./src",
    "outDir": "./dist",

    // Configurações do Ambiente Node.js
    "module": "nodenext",
    "target": "esnext",
    "types": ["node"],

    // Mapas e Saída
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    // Checagem de Tipos
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // Opções Recomendadas
    "strict": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "skipLibCheck": true
  },
  "include": ["src/**/*"]
}